{
  "name": "@synergy-network/dapp-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "validate": "python3 registry/validate.py",
    "test": "node --test registry/*.test.mjs",
    "build:apps": "pnpm --filter \"@synergy-network/dapp-wallet\" --filter \"@synergy-network/dapp-atlas\" --filter \"@synergy-network/dapp-keystone\" --filter \"@synergy-network/dapp-nodenetwork\" run build"
  },
  "workspaces": [
    "wallet",
    "atlas",
    "keystone",
    "nodenetwork",
    "registry",
    "shared/*"
  ],
  "devDependencies": {
    "vite": "8.3.2",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.2.12",
    "lightningcss-darwin-arm64": "1.33.0"
  }
}
